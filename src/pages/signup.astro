---
import Layout from '~/layouts/PageLayout.astro';
import SignupForm from '~/components/widgets/SignupForm';

const metadata = {
  title: 'Crear Cuenta - SG Cloud',
  description: 'Crea tu cuenta en SG Cloud para gestionar tu WhatsApp Business',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-20 mx-auto max-w-5xl">
    <SignupForm client:load locale="es" />
  </section>
</Layout>
