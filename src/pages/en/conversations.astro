---
import Layout from '~/layouts/PageLayout.astro';
import ConversationViewer from '~/components/widgets/ConversationViewer';

const metadata = {
  title: 'Conversations - SG Cloud',
  description: 'Customer conversation history',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-20 mx-auto max-w-7xl">
    <ConversationViewer client:load locale="en" />
  </section>
</Layout>
