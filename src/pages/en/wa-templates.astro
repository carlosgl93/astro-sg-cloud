---
import Layout from '~/layouts/PageLayout.astro';
import TemplateManager from '~/components/widgets/TemplateManager';
import HeroText from '~/components/widgets/HeroText.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://whatsapp-api-250058155586.us-central1.run.app';

const metadata = {
  title: 'WhatsApp Template Management - SG Cloud',
  description: 'Create, manage, and send WhatsApp Business templates with SG Cloud',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <HeroText tagline="WhatsApp Business" title="WhatsApp Template Management" subtitle="Create, manage, and test your WhatsApp Business message templates." />

  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-20 mx-auto max-w-5xl">
    <TemplateManager client:load apiUrl={apiUrl} />
  </section>
</Layout>
