---
import Layout from '~/layouts/PageLayout.astro';
import Dashboard from '~/components/widgets/Dashboard';
import FacebookSDK from '~/components/common/FacebookSDK.astro';

const metadata = {
  title: 'Dashboard - SG Cloud',
  description: 'Manage your WhatsApp Business from your dashboard',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <FacebookSDK />
  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-20 mx-auto max-w-6xl">
    <Dashboard client:load locale="en" />
  </section>
</Layout>
