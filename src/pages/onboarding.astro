---
import Layout from '~/layouts/PageLayout.astro';
import OnboardingWizard from '~/components/widgets/OnboardingWizard';
import FacebookSDK from '~/components/common/FacebookSDK.astro';

const metadata = {
  title: 'Configuración — SG Cloud',
  robots: { index: false, follow: false },
};

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://whatsapp-api-250058155586.us-central1.run.app';
---

<Layout metadata={metadata}>
  <Fragment slot="footer" />
  <FacebookSDK />
  <OnboardingWizard client:load apiUrl={apiUrl} locale="es" />
</Layout>
