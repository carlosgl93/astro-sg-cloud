---
import Layout from '~/layouts/PageLayout.astro';
import AdminPanel from '~/components/widgets/AdminPanel';

const metadata = {
  title: 'Admin — SG Cloud',
  robots: { index: false, follow: false },
};

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://whatsapp-api-250058155586.us-central1.run.app';
---

<Layout metadata={metadata}>
  <Fragment slot="footer" />
  <AdminPanel client:load apiUrl={apiUrl} locale="es" />
</Layout>
